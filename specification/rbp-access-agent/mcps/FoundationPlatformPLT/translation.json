    {
      "name": "list_picklistoption_for_sfodata",
      "title": "list_PicklistOption_for_sfodata",
      "description": "Retrieve a list of entities from the PicklistOption collection in the sfodata service. Supports OData query options for filtering, sorting, ranking ($top), skipping ($skip), expanding related entities, counting, selecting specific properties. Only use attributes in the query options that are specified in the metadata. If the structure of the entity is not known, call get_metadata_sfodata tool first to get the metadata.",
      "odataType": {
        "entitySet": {
          "name": "PicklistOption",
          "crudOperation": "read",
          "parameters": [
            {
              "name": "filter"
