  "servers": {
    "sf-rbp-genai": {
      "mcp_server_name": "sap.mcp/role_based_permissions_generative_ai_troubleshooting",
      "description": "SAP SuccessFactors RBP Generative AI Troubleshooting API — diagnoses RBP access issues",
      "tools": {
        "POST_rest_iam_authorization_genai_v1_permissions": {
          "description": "Analyse an RBP access issue and return a diagnosis with recommended permission group fix",
          "input_schema": {
            "type": "object",
            "properties": {
              "userId": { "type": "string", "description": "User ID of the affected employee" },
              "issueDescription": { "type": "string", "description": "Plain-language description of the access issue" },
              "module": { "type": "string", "description": "SAP SuccessFactors module affected (e.g. Compensation)" }
            },
            "required": ["userId", "issueDescription"]
          },
          "mock_response": {
            "diagnosis": {
              "rootCause": "User is missing the Compensation Planner permission group",
              "affectedModule": "Compensation",
              "recommendedPermissionGroup": "Compensation Planner",
              "changeType": "assign",
              "confidence": "HIGH",
              "justification": "The user's role as HR Business Partner requires access to compensation planning. The Compensation Planner group grants the necessary read and write access to compensation worksheets."
            }
          }
        },
        "POST_rest_iam_authorization_genai_v1_groups": {
          "description": "Get RBP group membership recommendations for a user",
          "input_schema": {
            "type": "object",
            "properties": {
              "userId": { "type": "string", "description": "User ID" },
              "targetGroups": { "type": "array", "items": { "type": "string" }, "description": "Permission groups to evaluate" }
            },
            "required": ["userId"]
          },
          "mock_response": {
            "recommendations": [
              {
                "group": "Compensation Planner",
                "recommended": true,
                "reason": "Required for compensation module access"
              }
            ]
          }
        },
        "GET_rest_iam_authorization_genai_v1_roles": {
          "description": "Get available RBP roles for AI-assisted assignment",
          "input_schema": {
            "type": "object",
            "properties": {
              "module": { "type": "string", "description": "Filter by module" }
            }
          },
          "mock_response": {
            "results": [
              { "roleId": "COMP_PLANNER", "roleName": "Compensation Planner", "module": "Compensation" },
              { "roleId": "PERF_USER", "roleName": "Performance User", "module": "Performance" },
              { "roleId": "HR_ADMIN", "roleName": "HR Administrator", "module": "All" }
            ]
          }
        }
      }
    },
